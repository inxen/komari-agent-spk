#!/bin/bash
#
# start-stop-status - manage the Komari Agent service lifecycle.
#
# Invoked by Synology Package Center / synopkg with:
#   $1 = start | stop | status | restart
#
# Design notes (see project docs / Phase 1 analysis):
#   - komari-agent runs in the foreground with an unbounded loop, so we run
#     it as a background daemon and track its PID.
#   - The agent exits(1) at startup if the config file cannot be read, so we
#     make sure a config exists before starting.
#   - SIGTERM triggers a graceful shutdown inside the agent, so we prefer it
#     and only escalate to SIGKILL after a timeout.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
SYNOPKG_PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/KomariAgent/target}"
SYNOPKG_PKGNAME="${SYNOPKG_PKGNAME:-KomariAgent}"

DAEMON="$SYNOPKG_PKGDEST/bin/komari-agent"
# Runtime data lives in the persistent @appdata dir (survives upgrade/uninstall).
SYNOPKG_PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/KomariAgent/var}"
VAR_DIR="$SYNOPKG_PKGVAR"
CONFIG_FILE="$VAR_DIR/config.json"
PID_FILE="$VAR_DIR/komari-agent.pid"
ROTATOR_PID_FILE="$VAR_DIR/komari-agent.rotator.pid"
LOG_DIR="$VAR_DIR/log"
LOG_FILE="$LOG_DIR/komari-agent.log"

# How long to wait for a graceful SIGTERM shutdown before SIGKILL.
STOP_TIMEOUT=15

# How often the background rotator checks the log size while the agent runs.
ROTATE_INTERVAL="${ROTATE_INTERVAL:-300}"   # seconds

# ---------------------------------------------------------------------------
# Logging policy
# ---------------------------------------------------------------------------
# Follow upstream behavior: the agent always logs to stdout/stderr, which we
# redirect to LOG_FILE. Normal (connected) operation produces almost nothing,
# but a unreachable panel emits ~7 MB/day - so a lightweight background loop
# keeps rotating while the service runs. Hard disk ceiling: ~10 MiB x 4 files.
# See rotate_log below for size/backup settings.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
is_running() {
    # Returns 0 if a live process with the stored PID exists.
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    # Validate it is actually the komari-agent process (not a recycled PID).
    if [ -r "/proc/$pid/cmdline" ] && grep -q "komari-agent" "/proc/$pid/cmdline" 2>/dev/null; then
        return 0
    fi
    # Fall back to a plain "process exists" check for non-Linux /proc-less env.
    kill -0 "$pid" 2>/dev/null
}

# Max log size before rotating (bytes) and number of rotated backups kept.
LOG_MAX_SIZE=10485760   # 10 MiB
LOG_MAX_BACKUPS=3

rotate_log() {
    # Simple size-based rotation so the log never grows without bound.
    [ -f "$LOG_FILE" ] || return 0
    local size
    size="$(wc -c < "$LOG_FILE" 2>/dev/null || echo 0)"
    if [ "$size" -gt "$LOG_MAX_SIZE" ]; then
        local i
        # Shift backups: .2 -> .3, .1 -> .2
        i=$LOG_MAX_BACKUPS
        while [ "$i" -gt 1 ]; do
            [ -f "$LOG_FILE.$((i-1))" ] && mv -f "$LOG_FILE.$((i-1))" "$LOG_FILE.$i" 2>/dev/null
            i=$((i-1))
        done
        # copytruncate: copy the current log to .1, then truncate it IN PLACE.
        # The agent appends via a long-lived file descriptor; mv would make it
        # keep writing to the renamed (backup) file so the live log would never
        # grow and the backup would grow unbounded. Truncating keeps the fd
        # pointing at $LOG_FILE (same inode), so new output lands in the live
        # log again and the 10 MiB ceiling holds.
        cp -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
        : > "$LOG_FILE"
        echo "[start-stop-status] Rotated $LOG_FILE"
    fi
}

daemon_start() {
    mkdir -p "$VAR_DIR" "$LOG_DIR"
    chmod 755 "$VAR_DIR" "$LOG_DIR"

    # The agent fails to start if the config file is missing, so provision a
    # default one on first start. Existing user config is never overwritten.
    if [ ! -f "$CONFIG_FILE" ]; then
        if [ -f "$SYNOPKG_PKGDEST/var/config.example.json" ]; then
            cp -f "$SYNOPKG_PKGDEST/var/config.example.json" "$CONFIG_FILE"
        else
            echo '{}' > "$CONFIG_FILE"
        fi
        chmod 600 "$CONFIG_FILE"
        echo "[start-stop-status] Created default $CONFIG_FILE (please edit it to add endpoint/token)."
    fi

    # Prevent duplicate startup (also cleans up any stale rotator).
    if is_running; then
        echo "Komari Agent is already running."
        return 0
    fi

    # Follow upstream behavior: agent logs to stdout/stderr, redirected to the
    # log file. Size-based rotation caps total disk usage (~10 MiB x 4 files).
    rotate_log
    "$DAEMON" --config "$CONFIG_FILE" >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    chmod 644 "$PID_FILE"

    # Give it a moment to bind and verify it stays alive (it dies quickly on
    # a bad config/command line).
    sleep 2
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "Komari Agent failed to start. Check $CONFIG_FILE (endpoint/token). See $LOG_FILE." >&2
        rm -f "$PID_FILE"
        return 1
    fi

    # Keep rotation running while the service runs, so a long-lived process
    # (e.g. panel unreachable, ~7 MB/day) can never grow the log unbounded.
    (
        while :; do
            sleep "$ROTATE_INTERVAL"
            rotate_log
        done
    ) > /dev/null 2>&1 &
    echo $! > "$ROTATOR_PID_FILE"

    echo "Komari Agent started (pid $pid)."
    return 0
}

stop_rotator() {
    if [ -f "$ROTATOR_PID_FILE" ]; then
        local rpid
        rpid="$(cat "$ROTATOR_PID_FILE" 2>/dev/null)"
        if [ -n "$rpid" ]; then
            # Kill the rotator's children (a `sleep N` may be running and would
            # otherwise linger as an orphan for up to N seconds) then itself.
            pkill -P "$rpid" 2>/dev/null || true
            kill "$rpid" 2>/dev/null || true
        fi
        rm -f "$ROTATOR_PID_FILE"
    fi
}

daemon_stop() {
    stop_rotator
    if ! is_running; then
        # Not running - make sure there is no stale PID file.
        rm -f "$PID_FILE"
        echo "Komari Agent is not running."
        return 0
    fi

    local pid
    pid="$(cat "$PID_FILE")"

    # Graceful stop: SIGTERM first.
    kill -TERM "$pid" 2>/dev/null || true

    # Wait for graceful exit, then escalate to SIGKILL.
    local waited=0
    while [ "$waited" -lt "$STOP_TIMEOUT" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE"
            echo "Komari Agent stopped gracefully."
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    # Timeout reached - force kill.
    kill -KILL "$pid" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "Komari Agent stopped (forced after timeout)."
    return 0
}

# ---------------------------------------------------------------------------
# Command dispatch
# ---------------------------------------------------------------------------
case "$1" in
    start)
        daemon_start
        ;;
    stop)
        daemon_stop
        ;;
    status)
        if is_running; then
            echo "Komari Agent is running."
            exit 0
        else
            echo "Komari Agent is not running."
            exit 1
        fi
        ;;
    restart)
        daemon_stop
        daemon_start
        ;;
    *)
        echo "Usage: $0 {start|stop|status|restart}" >&2
        exit 1
        ;;
esac
